    "@whatsapp-business/shared": "file:../../packages/shared",
    "bullmq": "^5.80.10",
    "ioredis": "^5.11.1",
    "joi": "^18.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
